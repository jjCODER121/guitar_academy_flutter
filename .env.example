# Скопируйте в .env (для docker compose) или в server/.env (для cargo run)
# и задайте свои значения. Файлы .env в git не попадают.

# Администратор создаётся при первом запуске, если его ещё нет.
# Потом пароль меняется командой: guitar_school_server admin <логин> <новый пароль>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ключ подписи временных ссылок на видео и PDF: длинная случайная строка (32+ символа).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
MEDIA_SECRET=

# Название школы в шапке админки
SCHOOL_NAME=[Название школы]

# Папка для базы и файлов (в Docker — /data, задано в Dockerfile)
# DATA_DIR=data

# На сервере с доменом и HTTPS — true (cookie входа только по HTTPS)
COOKIE_SECURE=false

# Максимальный размер загружаемого видео, МБ
MAX_UPLOAD_MB=4096

# Для cargo run на этом компьютере (8080 занят другой программой)
BIND_ADDR=127.0.0.1:8088
ADMIN_STATIC_DIR=../admin/static
LOG_FORMAT=pretty
