{
  "$description": "Единый источник design tokens. После правки: dart run tools/gen_tokens.dart",
  "color": {
    "background":     { "dark": "#0F0E0D", "light": "#FAF8F5", "usage": "Фон экранов" },
    "surface":        { "dark": "#1B1917", "light": "#FFFFFF", "usage": "Карточки, плеер, нижняя панель" },
    "surfaceAlt":     { "dark": "#262320", "light": "#F1EDE7", "usage": "Строки уроков, поля ввода" },
    "border":         { "dark": "#3A3631", "light": "#E7E1D8", "usage": "Контурные кнопки, трек ползунка (нет в брифе, из макетов)" },
    "textPrimary":    { "dark": "#F5F1EA", "light": "#1A1714", "usage": "Заголовки, основной текст" },
    "textSecondary":  { "dark": "#9A948B", "light": "#6E675E", "usage": "Длительность, подписи" },
    "accent":         { "dark": "#E0A040", "light": "#C9822A", "usage": "Кнопка «Купить», прогресс, активные иконки" },
    "accentOn":       { "dark": "#1A1206", "light": "#1A1206", "usage": "Текст на акцентной кнопке (light: в брифе #FFFFFF, не проходит AA)" },
    "success":        { "dark": "#6FBF73", "light": "#3E8E43", "usage": "Галочка «пройдено»" },
    "danger":         { "dark": "#E8846A", "light": "#9A3B1F", "usage": "Ошибки, возвраты (нет в брифе, из макетов)" },
    "locked":         { "dark": "#5C5650", "light": "#B5ADA3", "usage": "Замок на закрытых уроках" }
  },
  "contrastChecks": [
    ["textPrimary", "background"],
    ["textPrimary", "surface"],
    ["textPrimary", "surfaceAlt"],
    ["textSecondary", "background"],
    ["textSecondary", "surface"],
    ["textSecondary", "surfaceAlt"],
    ["accentOn", "accent"],
    ["danger", "background"],
    ["danger", "surface"]
  ],
  "font": {
    "family": "Manrope",
    "fallback": ["InterTajik"]
  },
  "text": {
    "screenTitle":  { "size": 28, "weight": 700, "height": 1.2,  "letterSpacing": -0.5, "usage": "Заголовок экрана" },
    "albumTitle":   { "size": 22, "weight": 700, "height": 1.25, "letterSpacing": -0.3, "usage": "Название альбома" },
    "sectionTitle": { "size": 20, "weight": 700, "height": 1.25, "letterSpacing": 0,    "usage": "Заголовок ряда на Главной" },
    "lessonTitle":  { "size": 16, "weight": 600, "height": 1.3,  "letterSpacing": 0,    "usage": "Название урока" },
    "body":         { "size": 16, "weight": 500, "height": 1.4,  "letterSpacing": 0,    "usage": "Основной текст, поля ввода" },
    "button":       { "size": 17, "weight": 700, "height": 1.2,  "letterSpacing": 0,    "usage": "Главная кнопка" },
    "caption":      { "size": 13, "weight": 500, "height": 1.35, "letterSpacing": 0,    "usage": "Подписи, длительность" },
    "navLabel":     { "size": 11, "weight": 600, "height": 1.2,  "letterSpacing": 0,    "usage": "Подписи нижней панели" }
  },
  "space": {
    "xs": 8,
    "sm": 16,
    "md": 24,
    "lg": 32,
    "screen": 20
  },
  "radius": {
    "card": 20,
    "button": 16,
    "cover": 12
  },
  "size": {
    "tapTarget": 48,
    "button": 56,
    "icon": 24,
    "iconStroke": 2
  }
}
